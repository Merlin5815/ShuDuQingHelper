<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="数独辅助工具"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingBottom="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="首次使用请依次开启以下权限:"
        android:textSize="14sp"
        android:paddingBottom="8dp" />

    <Button
        android:id="@+id/btn_accessibility"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="① 开启无障碍服务" />

    <Button
        android:id="@+id/btn_overlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="② 开启悬浮窗权限" />

    <Button
        android:id="@+id/btn_capture"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="③ 开启截屏权限" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="（建议选择整个屏幕）"
        android:textSize="11sp"
        android:textColor="#999999"
        android:gravity="center"
        android:paddingBottom="2dp" />

    <Button
        android:id="@+id/btn_start"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="④ 启动悬浮窗"
        android:layout_marginTop="16dp"
        android:backgroundTint="#4CAF50" />

    <TextView
        android:id="@+id/info_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="#666666"
        android:paddingTop="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="使用教程"
        android:textSize="16sp"
        android:textStyle="bold"
        android:paddingTop="16dp"
        android:paddingBottom="4dp" />

    <!-- 教程内容: 可滚动, 占满剩余空间; 文本由 MainActivity 代码设置 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#F5F5F5"
        android:padding="8dp">

        <TextView
            android:id="@+id/help_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:lineSpacingExtra="2dp"
            android:fontFamily="monospace" />
    </ScrollView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="QQ交流群：936313524"
        android:textSize="13sp"
        android:textColor="#1E88E5"
        android:gravity="center"
        android:paddingTop="8dp"
        android:paddingBottom="4dp" />

</LinearLayout>
